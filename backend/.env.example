# Vaultline Environment Configuration (Example)
# DO NOT COMMIT REAL SECRETS. This file serves as documentation for environment variable names.
# Vaultline uses safe in-memory/test defaults if these are omitted.

VAULTLINE_MERCHANT_ID=merch_default
VAULTLINE_JUDGE_USERNAME=judge_merchant
VAULTLINE_JUDGE_PASSWORD=replace_with_strong_password_in_production
VAULTLINE_AGENT_ID=agent_default
VAULTLINE_AGENT_KEY=replace_with_agent_secret_key_in_production
VAULTLINE_DB_PATH=vaultline.db
VAULTLINE_LOG_LEVEL=INFO

