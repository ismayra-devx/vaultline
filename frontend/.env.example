# Vaultline FastAPI origin. Leave empty when the SPA is served from the same origin as the API.
VITE_API_BASE_URL=http://localhost:8000
# AG Studio licence key (public by design; Studio shows a trial watermark without it)
VITE_AG_STUDIO_LICENSE_KEY=
# true = clearly-labelled demo fixtures for layout work. NEVER set for the judge build.
VITE_DEMO_FIXTURES=
